# URL de teselas del mapa (opcional). Por defecto se usa OpenStreetMap, sin cuenta ni clave.
# Mantener la atribución visible y un uso moderado; ver README para cambiar de proveedor.
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Client ID de OAuth de Google (opcional). Sin este valor no aparece el botón "Continuar con Google".
# Debe coincidir con GOOGLE_CLIENT_ID del módulo Api_Externas y tener el origen de la web autorizado en Google Cloud.
VITE_GOOGLE_CLIENT_ID=
